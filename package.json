{
  "name": "rub-off",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ping": "node --env-file-if-exists=.env.local scripts/ping.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts'",
    "pattern": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/pattern.ts",
    "size": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/size.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "clipper-lib": "^6.4.2",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
